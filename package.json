{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.1",
  "description": "DeepSeek Harness desktop app: the official dsh web UI in a native Electron shell, with embedded server management, tray and notifications.",
  "main": "src/main.js",
  "author": "DeepSeek Harness Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "smoke": "electron . --smoke",
    "preview": "node scripts/preview-status.js",
    "package:app": "electron-packager . \"DeepSeek Harness\" --platform=win32 --arch=x64 --out=release --icon=assets/icon.png --overwrite",
    "pack": "npm run package:app",
    "update:dsh": "node scripts/update-dsh.js",
    "zip": "tar -a -c -f \"release/DeepSeek Harness-0.1.1-win32-x64.zip\" -C release \"DeepSeek Harness-win32-x64\"",
    "verify": "node scripts/verify-package.js",
    "dist": "npm run package:app && electron-builder --win --prepackaged \"release/DeepSeek Harness-win32-x64\" && npm run zip && npm run verify"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
